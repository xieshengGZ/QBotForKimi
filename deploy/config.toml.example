# kimico 的唯一配置文件。
#
# 安装后只需改下面两个 QQ 号，然后：
#   sudo systemctl restart kimico
#
# 端口、access token、NapCat 的 OneBot 配置都会自动生成，
# 不需要也不应该手工填写。

[qq]
# 网关 QQ：机器上的 NapCat 登录的机器人账号。
# 请使用专用小号，不要用主账号。
gateway_qq = 1000000000

# 主 QQ：你手机上的账号，用来私聊控制这台机器。
main_qq = 1000000001

# 可选：kimi 命令。删掉或留空时自动查找 kimi/kimico。
# --auto = Never Ask 模式：工具调用和命令自动执行。
# [kimico]
# command = "/home/ubuntu/.kimi-code/bin/kimi --auto"
# working_directory = "/home/ubuntu/qq_work"

# 可选：NapCat 镜像。默认值是一个真实存在的固定版本。
# [napcat]
# image = "mlikiowa/napcat-docker:v4.8.124"
# container = "kimico-napcat"
